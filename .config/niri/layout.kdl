layout {
  gaps 2

  struts { left 0; right 0; top 2; bottom 2; }

  focus-ring {
    width 1
    active-color "#7fc8ff"
    inactive-color "#505050"
  }

  preset-window-heights {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 1.0
  }

  default-column-width { proportion 0.33333; }
  preset-column-widths {
    proportion 0.25
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
    proportion 0.75
    proportion 1.0
  }
  always-center-single-column
}
